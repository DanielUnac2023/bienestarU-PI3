generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tus enumerados y modelos (Usuario, Rol, etc.)
enum Rol {
  ESTUDIANTE
  PROFESIONAL_CAU
  ENCARGADO_CAU
  ADMIN
}

enum EstadoUsuario {
  ACTIVO
  SANCIONADO
}

model Usuario {
  id        Int           @id @default(autoincrement())
  nombre    String
  correo    String        @unique
  googleId  String?       @map("google_id")
  rol       Rol           @default(ESTUDIANTE)
  estado    EstadoUsuario @default(ACTIVO)
  creadoEn  DateTime      @default(now()) @map("creado_en")

  @@map("usuarios")
}

// ------------ Cambios Duvan - Modulo reserva-espacios

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  FINALIZADA
}

model EspacioDeportivo {
  id               String    @id @default(uuid())
  nombre           String
  minParticipantes Int       @default(1)
  reservas         Reserva[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Reserva {
  id                 String           @id @default(uuid())
  usuarioId          String           // ID del usuario (clave foránea cuando exista el módulo de Usuarios)
  espacioId          String
  espacio            EspacioDeportivo @relation(fields: [espacioId], references: [id])
  fechaInicio        DateTime
  fechaFin           DateTime
  cantidadPersonas   Int
  estado             EstadoReserva    @default(PENDIENTE)
  createdAt          DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}


// ------------ Cambios Gabriel - Modulo Citas 


 enum CategoriaServicio {
  PSICOLOGIA
  NUTRICION
  ESPIRITUAL
}

enum EstadoCita {
  PROGRAMADA
  ATENDIDA
  CANCELADA
}

model agendamiento {
  id              String            @id @default(uuid())
  estudianteId    String
  profesionalId   String
  categoria       CategoriaServicio
  fechaHoraInicio DateTime
  fechaHoraFin    DateTime
  lugar           String            @default("Oficina CAU")
  motivo          String?
  estado          EstadoCita        @default(PROGRAMADA)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("agendamientos")
}

model DisponibilidadProfesional {
  id              String            @id @default(uuid())
  profesionalId   String
  categoria       CategoriaServicio
  fechaHoraInicio DateTime
  fechaHoraFin    DateTime
  activo          Boolean           @default(true)
  createdAt       DateTime          @default(now())

  @@map("disponibilidades_profesionales")
}
