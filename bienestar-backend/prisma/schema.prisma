generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tus enumerados y modelos (Usuario, Rol, etc.)
enum Rol {
  ESTUDIANTE
  PROFESIONAL_CAU
  ENCARGADO_CAU
  ADMIN
}

enum EstadoUsuario {
  ACTIVO
  SANCIONADO
}

model Usuario {
  id        Int           @id @default(autoincrement())
  nombre    String
  correo    String        @unique
  googleId  String?       @map("google_id")
  rol       Rol           @default(ESTUDIANTE)
  estado    EstadoUsuario @default(ACTIVO)
  creadoEn  DateTime      @default(now()) @map("creado_en")

  @@map("usuarios")
}


// -------------------------------- modicacion gabriel 


 enum CategoriaServicio {
  PSICOLOGIA
  NUTRICION
  ESPIRITUAL
}

enum EstadoCita {
  PROGRAMADA
  ATENDIDA
  CANCELADA
}

model agendamiento {
  id              String            @id @default(uuid())
  estudianteId    String
  profesionalId   String
  categoria       CategoriaServicio
  fechaHoraInicio DateTime
  fechaHoraFin    DateTime
  lugar           String            @default("Oficina CAU")
  motivo          String?
  estado          EstadoCita        @default(PROGRAMADA)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("agendamientos")
}

model DisponibilidadProfesional {
  id              String            @id @default(uuid())
  profesionalId   String
  categoria       CategoriaServicio
  fechaHoraInicio DateTime
  fechaHoraFin    DateTime
  activo          Boolean           @default(true)
  createdAt       DateTime          @default(now())

  @@map("disponibilidades_profesionales")
}
