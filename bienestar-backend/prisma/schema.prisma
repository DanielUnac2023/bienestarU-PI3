generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tus enumerados y modelos (Usuario, Rol, etc.)
enum Rol {
  ESTUDIANTE
  PROFESIONAL_CAU
  ENCARGADO_CAU
  ADMIN
}

enum EstadoUsuario {
  ACTIVO
  SANCIONADO
}

model Usuario {
  id        Int           @id @default(autoincrement())
  nombre    String
  correo    String        @unique
  googleId  String?       @map("google_id")
  rol       Rol           @default(ESTUDIANTE)
  estado    EstadoUsuario @default(ACTIVO)
  creadoEn  DateTime      @default(now()) @map("creado_en")

  @@map("usuarios")
}

// Modulo reserva-espacios

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  FINALIZADA
}

model EspacioDeportivo {
  id               String    @id @default(uuid())
  nombre           String
  minParticipantes Int       @default(1)
  reservas         Reserva[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Reserva {
  id                 String           @id @default(uuid())
  usuarioId          String           // ID del usuario (clave foránea cuando exista el módulo de Usuarios)
  espacioId          String
  espacio            EspacioDeportivo @relation(fields: [espacioId], references: [id])
  fechaInicio        DateTime
  fechaFin           DateTime
  cantidadPersonas   Int
  estado             EstadoReserva    @default(PENDIENTE)
  createdAt          DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

